rules_version = '2';

// FOM Studios - Firestore security rules (project fom-studios)
// Paste this WHOLE file into Firebase Console > Firestore Database > Rules, then Publish.
// Last updated 5 Nov 2026: slotHolds and meetingRequests (Book a meeting); meetings (client meetings) and moodShare (client mood board links). Earlier: gallery favourites, chat, settings/outreach, settings/pitchDeck.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function myEmail() { return signedIn() && request.auth.token.email != null ? request.auth.token.email : ''; }
    // the signed-in client is the one on this booking (same email match as the orders rule)
    function isOrderClient(orderId) {
      return signedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.get('clientEmail', '') == myEmail();
    }

    // ---- admins: you can only read your own admin doc (the Worker upload check relies on this).
    //      Add or remove admins in the Firebase Console, never from the app.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- orders: admin does everything; a client reads only their own booking;
    //      anyone with the sign link can sign ONCE, changing only the signature fields.
    match /orders/{orderId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.clientEmail == myEmail());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    // the signed-in client saves their gallery favourites (a list of file names) on their own booking
                    || (
                         signedIn() && resource.data.get('clientEmail', '') == myEmail()
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favourites', 'favouritesAt'])
                         && request.resource.data.favourites is list
                         && request.resource.data.favourites.size() <= 1000
                         && request.resource.data.favouritesAt == request.time
                       )
                    || (
                         resource.data.get('contractSigned', false) != true
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['contractSigned', 'signatureData', 'signedName', 'signedAt'])
                         && request.resource.data.contractSigned == true
                         && request.resource.data.signedName is string
                         && request.resource.data.signedName.size() > 0
                         && request.resource.data.signedName.size() < 120
                         && request.resource.data.signatureData is string
                         && request.resource.data.signatureData.size() < 600000
                         && request.resource.data.signedAt == request.time
                       );
    }

    // ---- feedback (reviews): anyone can leave a review; only you can read or manage them.
    match /feedback/{id} {
      allow create: if request.resource.data.rating is int
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.get('message', '') is string
                    && request.resource.data.get('message', '').size() < 3000
                    && request.resource.data.get('name', '') is string
                    && request.resource.data.get('name', '').size() < 120;
      allow read, update, delete: if isAdmin();
    }

    // ---- public website content: anyone reads, only you write.
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /siteContent/{id} {            // site (contact, banner, blocked dates) and portfolio (photo list)
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- admin only ----
    match /settings/{id} {               // security, calculator, contract, checklist, outreach, pitchDeck
      allow read, write: if isAdmin();
    }
    match /leads/{id} {
      allow read, write: if isAdmin();
    }
    match /contentPlanner/{id} {
      allow read, write: if isAdmin();
    }
    // ---- Book a meeting (booking.js on both websites, bookings.html on the dashboard) ----
    match /slotHolds/{id} {              // a requested start time; no personal details, so the websites can read them
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['biz', 'start', 'len', 'at'])
                    && request.resource.data.biz in ['fom', 'sba']
                    && request.resource.data.start is string && request.resource.data.start.size() < 40
                    && request.resource.data.len in [30, 45, 60]
                    && request.resource.data.at == request.time
                    && id == request.resource.data.biz + '_' + request.resource.data.start;   // one hold per start time
      allow update, delete: if isAdmin();
    }
    match /meetingRequests/{id} {        // the request itself: anyone can send one, only you can read it
      allow create: if request.resource.data.keys().hasOnly(['biz', 'start', 'len', 'mode', 'name', 'phone', 'email', 'type', 'msg', 'status', 'hold', 'at'])
                    && request.resource.data.biz in ['fom', 'sba']
                    && request.resource.data.start is string && request.resource.data.start.size() < 40
                    && request.resource.data.len in [30, 45, 60]
                    && request.resource.data.mode in ['phone', 'video', 'inperson']   // in person is hidden on the websites for now
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 110
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
                    && request.resource.data.email is string && request.resource.data.email.size() <= 110
                    && request.resource.data.type is string && request.resource.data.type.size() <= 40
                    && request.resource.data.msg is string && request.resource.data.msg.size() <= 1400
                    && request.resource.data.status == 'new'
                    && request.resource.data.hold == request.resource.data.biz + '_' + request.resource.data.start
                    && request.resource.data.at == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /meetings/{id} {               // client meetings: notes, mood board picks, quote (meetings.html)
      allow read, write: if isAdmin();
    }

    // ---- moodShare: the private mood board link a client opens (portfolio moodboard.html?s=<id>).
    //      Anyone with the exact link can open it until it expires; nobody can list them.
    //      The client can only change their hearts (clientLoved), their own inspiration (clientInspo, up to 30) and the time they saved them.
    match /moodShare/{id} {
      allow get: if isAdmin() || resource.data.expiresAt > request.time;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (
                         resource.data.expiresAt > request.time
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientLoved', 'clientAt', 'clientInspo'])
                         && request.resource.data.clientLoved is list
                         && request.resource.data.clientLoved.size() <= 300
                         && (!('clientInspo' in request.resource.data)
                             || (request.resource.data.clientInspo is list && request.resource.data.clientInspo.size() <= 30))
                         && request.resource.data.clientAt == request.time
                       );
    }

    // ---- chat: one conversation per booking (doc id = the order's id).
    //      The chat doc only holds the latest-message summary and who has read it.
    match /chat/{orderId} {
      allow read: if isAdmin() || isOrderClient(orderId);
      allow create: if isAdmin()
                    || (
                         isOrderClient(orderId)
                         && request.resource.data.keys().hasOnly(['lastAt', 'lastFrom', 'lastText', 'clientReadAt'])
                         && request.resource.data.get('lastFrom', 'client') == 'client'
                         && request.resource.data.get('lastText', '') is string
                         && request.resource.data.get('lastText', '').size() <= 300
                       );
      allow update: if isAdmin()
                    || (
                         isOrderClient(orderId)
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastFrom', 'lastText', 'clientReadAt'])
                         && (!('lastFrom' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastFrom == 'client')
                         && request.resource.data.get('lastText', '') is string
                         && request.resource.data.get('lastText', '').size() <= 300
                       );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAdmin() || isOrderClient(orderId);
        allow create: if isAdmin()
                      || (
                           isOrderClient(orderId)
                           && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'name'])
                           && request.resource.data.from == 'client'
                           && request.resource.data.text is string
                           && request.resource.data.text.size() > 0
                           && request.resource.data.text.size() <= 2000
                           && request.resource.data.at == request.time
                         );
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---- everything else is closed by default ----
  }
}
