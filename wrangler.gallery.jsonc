{
  // fom-gallery Worker. Deploys on push: npx wrangler deploy -c wrangler.gallery.jsonc
  // Secrets (BREVO_KEY etc.) stay in Cloudflare and are not touched by deploys.
  "name": "fom-gallery",
  "main": "gallery-worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "keep_vars": true,
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "fom-deliverables" }
  ],
  // Website traffic (18 Nov 2026): SQLite Durable Object, free plan
  "durable_objects": { "bindings": [ { "name": "STATS", "class_name": "Stats" } ] },
  "migrations": [ { "tag": "v1-stats", "new_sqlite_classes": ["Stats"] } ],
  // 03:00 UTC: gallery auto-delete. Every hour: traffic alerts (spike, daily summary, weekly report)
  "triggers": { "crons": ["0 3 * * *", "0 * * * *"] }
}
